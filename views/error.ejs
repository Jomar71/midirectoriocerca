<% var titulo = 'Error — DirectorioCerca'; %>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head', { titulo: titulo }) %>
</head>
<body class="min-h-screen bg-white text-neutral-800 dark:bg-slate-900 dark:text-slate-100 font-sans grid place-items-center px-4">
  <main class="max-w-lg w-full text-center">
    <a href="/" class="inline-flex items-center gap-2.5 mb-8" aria-label="DirectorioCerca - Inicio">
      <span class="grid place-items-center w-10 h-10 rounded-xl bg-primary-800 text-white font-display font-extrabold text-xl">D</span>
      <span class="font-display font-bold text-xl tracking-tight text-neutral-900 dark:text-white">Directorio<span class="italic text-accent-600 dark:text-accent-400">Cerca</span></span>
    </a>
    <p class="font-display text-7xl font-semibold text-error-500 dc-tabular"><%= status %></p>
    <h1 class="mt-4 font-display text-3xl font-semibold text-neutral-900 dark:text-slate-100">Ocurrió un error</h1>
    <p class="mt-2 text-neutral-500 dark:text-slate-400"><%= message %></p>
    <a href="/" class="inline-grid place-items-center h-11 px-6 mt-7 rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-bold transition-colors">Volver al inicio</a>
  </main>
</body>
</html>
