<% var titulo = anuncio.razon_social + ' — DirectorioCerca'; %>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head', { titulo: titulo }) %>
  <% if (typeof meta !== 'undefined' && meta) { %>
    <meta name="description" content="<%= meta.description %>">
    <% if (meta.keywords) { %><meta name="keywords" content="<%= meta.keywords %>"><% } %>
    <link rel="canonical" href="<%= meta.url %>">
    <meta property="og:type" content="<%= meta.type %>">
    <meta property="og:title" content="<%= meta.title %>">
    <meta property="og:description" content="<%= meta.description %>">
    <meta property="og:url" content="<%= meta.url %>">
    <% if (meta.image) { %>
      <meta property="og:image" content="<%= meta.image %>">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:image" content="<%= meta.image %>">
    <% } else { %>
      <meta name="twitter:card" content="summary">
    <% } %>
    <meta name="twitter:title" content="<%= meta.title %>">
    <meta name="twitter:description" content="<%= meta.description %>">
  <% } %>
  <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
    <script type="application/ld+json"><%- jsonLd %></script>
  <% } %>
</head>
<body class="bg-neutral-50 text-neutral-800 dark:bg-slate-900 dark:text-slate-100 font-sans">
  <%- include('partials/header') %>

  <main id="contenido" class="max-w-6xl mx-auto px-3 sm:px-4 py-5 sm:py-6 lg:py-8">
    <!-- Breadcrumb -->
    <nav class="flex flex-wrap items-center text-sm text-neutral-500 dark:text-slate-400 mb-5 min-w-0 break-words" aria-label="Ruta">
      <a href="/" class="hover:text-primary-600 dark:hover:text-primary-400">Inicio</a>
      <span class="mx-1 text-neutral-300 dark:text-slate-600">/</span>
      <% if (anuncio.categoria_slug) { %>
        <a href="/resultados?categoria=<%= anuncio.categoria_slug %>" class="hover:text-primary-600 dark:hover:text-primary-400 truncate max-w-[40vw] sm:max-w-xs"><%= anuncio.categoria_nombre %></a>
        <span class="mx-1 text-neutral-300 dark:text-slate-600">/</span>
      <% } %>
      <span class="text-neutral-700 dark:text-slate-300 break-words"><%= anuncio.razon_social %></span>
    </nav>
    <h1 class="sr-only"><%= anuncio.razon_social %></h1>

    <div class="grid gap-5 sm:gap-6 lg:gap-8 lg:grid-cols-[1.7fr_1fr]">
      <!-- ── Columna principal ──────────────────────────────────── -->
      <div class="min-w-0 space-y-6">
        <!-- Galería de fotografías con lightbox -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-neutral-200 dark:border-slate-700 overflow-hidden shadow-sm">
          <div class="relative">
            <div class="relative aspect-[4/3] sm:aspect-[16/10] bg-neutral-100 dark:bg-slate-700 cursor-zoom-in" id="galeria" role="button" tabindex="0" aria-label="Ampliar foto actual">
              <img id="galeria-principal" src="<%= fotos[0] ? fotos[0].url : '/img/placeholder.jpg' %>" alt="<%= anuncio.razon_social %>" width="1200" height="750" class="w-full h-full object-cover">
              <span class="absolute bottom-2 left-2 sm:bottom-3 sm:left-3 inline-flex items-center gap-1.5 rounded-full bg-neutral-900/70 px-2.5 sm:px-3 py-1 text-xs font-medium text-white backdrop-blur">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path stroke-linecap="round" stroke-linejoin="round" d="m21 16-4.5-4.5L7 21"/></svg>
                <%= fotos.length || 1 %> foto<%= (fotos.length || 1) === 1 ? '' : 's' %>
              </span>
            </div>
            <% if (fotos.length > 1) { %>
              <button type="button" id="gal-prev" aria-label="Foto anterior" class="absolute left-2 sm:left-3 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/90 dark:bg-slate-800/90 hover:bg-white text-neutral-900 dark:text-slate-100 grid place-items-center shadow transition-colors">&lsaquo;</button>
              <button type="button" id="gal-next" aria-label="Foto siguiente" class="absolute right-2 sm:right-3 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/90 dark:bg-slate-800/90 hover:bg-white text-neutral-900 dark:text-slate-100 grid place-items-center shadow transition-colors">&rsaquo;</button>
            <% } %>
          </div>
          <% if (fotos.length > 1) { %>
            <div class="flex gap-2 p-2 sm:p-3 overflow-x-auto bg-white dark:bg-slate-800 scroll-smooth snap-x snap-proximity">
              <% fotos.forEach(function(f, i){ %>
                <button type="button" class="gal-thumb shrink-0 w-16 h-12 sm:w-20 sm:h-16 rounded-lg overflow-hidden border-2 snap-start <%= i===0 ? 'border-primary-600' : 'border-neutral-200 dark:border-slate-600' %>" data-src="<%= f.url %>" aria-label="Ver foto <%= i+1 %>">
                  <img src="<%= f.url %>" alt="Foto <%= i+1 %>" width="320" height="256" loading="lazy" class="w-full h-full object-cover">
                </button>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- Portafolio empresarial (50 palabras) -->
        <section class="bg-white dark:bg-slate-800 rounded-2xl border border-neutral-200 dark:border-slate-700 p-4 sm:p-6 lg:p-7 shadow-sm min-w-0">
          <h2 class="font-display text-xl sm:text-2xl font-semibold tracking-tight text-neutral-900 dark:text-slate-100 break-words">Sobre esta empresa</h2>
          <p class="mt-3 text-neutral-600 dark:text-slate-300 leading-relaxed whitespace-pre-line break-words"><%= anuncio.descripcion_50 %></p>
          <% if (keywords.length) { %>
            <div class="mt-6 pt-5 border-t border-neutral-100 dark:border-slate-700">
              <p class="text-xs font-bold uppercase tracking-wider text-neutral-500 dark:text-slate-400 mb-3">Palabras clave</p>
              <div class="flex flex-wrap gap-2">
                <% keywords.forEach(function(k){ %>
                  <span class="text-xs bg-primary-50 text-primary-700 dark:bg-primary-500/15 dark:text-primary-300 rounded-full px-3 py-1"><%= k %></span>
                <% }) %>
              </div>
            </div>
          <% } %>
        </section>

        <!-- Mapa geosatelital -->
        <% if (mapsEmbed) { %>
        <section class="bg-white dark:bg-slate-800 rounded-2xl border border-neutral-200 dark:border-slate-700 p-4 sm:p-6 lg:p-7 shadow-sm min-w-0">
          <h2 class="font-display text-xl sm:text-2xl font-semibold tracking-tight text-neutral-900 dark:text-slate-100 break-words">Ubicación</h2>
          <% if (anuncio.direccion) { %>
            <p class="text-neutral-500 dark:text-slate-400 mt-1 mb-4 break-words"><%= [anuncio.direccion, anuncio.ciudad, anuncio.pais].filter(Boolean).join(', ') %></p>
          <% } %>
          <div class="rounded-xl overflow-hidden border border-neutral-200 dark:border-slate-700 w-full min-w-0">
            <iframe title="Mapa de ubicación" src="<%= mapsEmbed %>" width="100%" height="360" style="border:0; width:100%; min-height:260px;" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="w-full"></iframe>
          </div>
        </section>
        <% } %>

        <!-- Formulario de contacto -->
        <section class="bg-white dark:bg-slate-800 rounded-2xl border border-neutral-200 dark:border-slate-700 p-4 sm:p-6 lg:p-7 shadow-sm min-w-0">
          <h2 class="font-display text-xl sm:text-2xl font-semibold tracking-tight text-neutral-900 dark:text-slate-100 break-words">Escribe a este negocio</h2>
          <p class="text-neutral-500 dark:text-slate-400 mt-1 break-words">Tu mensaje queda registrado para que el equipo de DirectorioCerca pueda dar seguimiento a tu consulta.</p>
          <form id="contacto-form" class="mt-6 grid gap-4 sm:grid-cols-2 w-full min-w-0">
            <input type="hidden" name="anuncio_slug" value="<%= anuncio.slug %>">
            <input name="nombre" required placeholder="Tu nombre" aria-label="Tu nombre" autocomplete="name" class="h-11 px-4 rounded-xl bg-neutral-100 dark:bg-slate-700 border border-neutral-200 dark:border-slate-600 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500 w-full min-w-0">
            <input name="email" type="email" required placeholder="Tu email" aria-label="Tu email" autocomplete="email" class="h-11 px-4 rounded-xl bg-neutral-100 dark:bg-slate-700 border border-neutral-200 dark:border-slate-600 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500 w-full min-w-0">
            <input name="telefono" type="tel" inputmode="tel" placeholder="Teléfono (opcional)" aria-label="Teléfono" autocomplete="tel" class="sm:col-span-2 h-11 px-4 rounded-xl bg-neutral-100 dark:bg-slate-700 border border-neutral-200 dark:border-slate-600 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500 w-full min-w-0">
            <textarea name="mensaje" required rows="4" placeholder="Escribe tu mensaje..." aria-label="Mensaje" class="sm:col-span-2 px-4 py-3 rounded-xl bg-neutral-100 dark:bg-slate-700 border border-neutral-200 dark:border-slate-600 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500 w-full min-w-0 resize-y"></textarea>
            <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
              <button type="submit" class="px-6 h-11 grid place-items-center rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-bold transition-colors whitespace-nowrap">Enviar mensaje</button>
              <span id="contacto-msg" class="text-sm break-words" role="status"></span>
            </div>
          </form>
        </section>
      </div>

      <!-- ── Tarjeta de contacto ────────────────────────────────── -->
      <aside class="lg:sticky lg:top-24 h-max">
        <div class="rounded-2xl overflow-hidden border border-neutral-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-lg shadow-primary-950/[0.07] dark:shadow-black/40">
          <!-- Encabezado de marca -->
          <div class="relative overflow-hidden bg-gradient-to-br from-primary-800 to-primary-950 p-4 sm:p-6 text-white">
            <div class="absolute inset-0 opacity-[0.12]" style="background-image:radial-gradient(circle,#ffffff 1px,transparent 1px);background-size:20px 20px" aria-hidden="true"></div>
            <div class="relative">
              <% if (anuncio.categoria_nombre) { %>
                <span class="inline-block text-xs font-bold text-neutral-900 bg-accent-400 rounded-full px-3 py-1 mb-3"><%= anuncio.categoria_nombre %></span>
              <% } %>
              <h2 class="font-display text-xl sm:text-2xl lg:text-3xl font-semibold leading-tight text-white text-balance break-words"><%= anuncio.razon_social %></h2>
              <div class="flex items-center gap-1.5 text-sm text-primary-100 mt-3">
                <svg class="w-4 h-4 text-accent-400 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.6-7-11a7 7 0 1 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
                <span class="break-words"><%= [anuncio.ciudad, anuncio.pais].filter(Boolean).join(', ') || 'Sin ubicación' %></span>
              </div>
            </div>
          </div>

          <!-- Acciones rápidas -->
          <div class="p-4 sm:p-6 space-y-2.5">
            <% if (anuncio.telefono_movil) { %>
            <a href="tel:<%= anuncio.telefono_movil %>" class="flex items-center gap-3 px-3 sm:px-4 py-3 rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-semibold transition-colors">
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.5 3h3l1.5 4-2 1.5a13 13 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 4.5 5a2 2 0 0 1 2-2Z"/></svg>
              <span class="truncate text-sm sm:text-base">Llamar al <%= anuncio.telefono_movil %></span>
            </a>
            <% } %>
            <% if (typeof whatsappDirectUrl !== 'undefined' && whatsappDirectUrl) { %>
              <a href="<%= whatsappDirectUrl %>" target="_blank" rel="noopener" class="flex items-center justify-center gap-2.5 px-4 py-3 rounded-xl bg-whatsapp text-neutral-900 font-bold hover:bg-whatsapp-hover transition-colors shadow-sm">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.5 3.8 8 3.1l1.5 4-1.7 1.3a13 13 0 0 0 6.8 6.8l1.3-1.7 4 1.5-.7 1.5A2.3 2.3 0 0 1 16.9 18.6 16 16 0 0 1 5.4 7.1 2.3 2.3 0 0 1 6.5 3.8Z"/></svg>
                <span>Chatear por WhatsApp</span>
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
            <% } %>
            <% if (anuncio.email) { %>
              <a href="mailto:<%= anuncio.email %>" class="flex items-center gap-3 px-3 sm:px-4 py-3 rounded-xl border border-neutral-200 dark:border-slate-600 text-neutral-700 dark:text-slate-200 hover:bg-neutral-50 dark:hover:bg-slate-700 font-medium transition-colors">
                <svg class="w-5 h-5 shrink-0 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6"/></svg>
                <span class="truncate text-sm sm:text-base"><%= anuncio.email %></span>
              </a>
            <% } %>
            <% if (anuncio.sitio_web) { %>
              <a href="<%= anuncio.sitio_web %>" target="_blank" rel="noopener" class="flex items-center gap-3 px-3 sm:px-4 py-3 rounded-xl border border-neutral-200 dark:border-slate-600 text-neutral-700 dark:text-slate-200 hover:bg-neutral-50 dark:hover:bg-slate-700 font-medium transition-colors">
                <svg class="w-5 h-5 shrink-0 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/></svg>
                <span class="text-sm sm:text-base">Visitar sitio web</span>
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
            <% } %>
            <!-- Compartir por WhatsApp -->
            <a href="https://wa.me/?text=<%= whatsappText %>" target="_blank" rel="noopener" class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-neutral-200 dark:border-slate-600 text-neutral-600 dark:text-slate-300 hover:bg-neutral-50 dark:hover:bg-slate-700 text-xs font-semibold transition-colors">
              <svg class="w-4 h-4 text-whatsapp shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.5 3.8 8 3.1l1.5 4-1.7 1.3a13 13 0 0 0 6.8 6.8l1.3-1.7 4 1.5-.7 1.5A2.3 2.3 0 0 1 16.9 18.6 16 16 0 0 1 5.4 7.1 2.3 2.3 0 0 1 6.5 3.8Z"/></svg>
              <span>Compartir anuncio por WhatsApp</span>
              <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          </div>

          <!-- Datos direccionales -->
          <% if (anuncio.direccion || anuncio.telefono_fijo || anuncio.telefono_movil) { %>
                <dl class="px-4 sm:px-6 py-4 sm:py-5 border-t border-neutral-100 dark:border-slate-700 space-y-2.5 text-sm break-words">
              <% if (anuncio.direccion) { %><div class="flex flex-col sm:flex-row gap-1 sm:gap-3"><dt class="text-neutral-500 dark:text-slate-400 sm:w-24 shrink-0">Dirección</dt><dd class="text-neutral-700 dark:text-slate-200 break-words overflow-wrap-anywhere"><%= anuncio.direccion %></dd></div><% } %>
              <% if (anuncio.telefono_fijo) { %><div class="flex flex-col sm:flex-row gap-1 sm:gap-3"><dt class="text-neutral-500 dark:text-slate-400 sm:w-24 shrink-0">Tel. fijo</dt><dd class="text-neutral-700 dark:text-slate-200 break-words"><%= anuncio.telefono_fijo %></dd></div><% } %>
              <% if (anuncio.telefono_movil) { %><div class="flex flex-col sm:flex-row gap-1 sm:gap-3"><dt class="text-neutral-500 dark:text-slate-400 sm:w-24 shrink-0">Tel. móvil</dt><dd class="text-neutral-700 dark:text-slate-200 break-words"><%= anuncio.telefono_movil %></dd></div><% } %>
            </dl>
          <% } %>

          <!-- Redes sociales -->
          <% var redes = [
              {u: anuncio.youtube, l:'YouTube', c:'bg-[#FF0000]'},
              {u: anuncio.facebook, l:'Facebook', c:'bg-[#1877F2]'},
              {u: anuncio.instagram, l:'Instagram', c:'bg-[#E1306C]'},
              {u: anuncio.tiktok, l:'TikTok', c:'bg-[#111111]'}
            ].filter(function(r){ return r.u; }); %>
          <% if (redes.length > 0) { %>
          <div class="px-4 sm:px-6 py-4 sm:py-5 border-t border-neutral-100 dark:border-slate-700">
            <p class="text-xs font-bold uppercase tracking-wider text-neutral-500 dark:text-slate-400 mb-3">Síguenos</p>
            <div class="flex flex-wrap gap-2">
              <% redes.forEach(function(r){ %>
                <a href="<%= r.u %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-2.5 sm:px-3 py-1.5 rounded-lg border border-neutral-200 dark:border-slate-600 text-neutral-700 dark:text-slate-200 text-xs sm:text-sm font-medium hover:bg-neutral-50 dark:hover:bg-slate-700 transition-colors">
                  <span class="w-2 h-2 rounded-full <%= r.c %>" aria-hidden="true"></span>
                  <%= r.l %>
                  <span class="sr-only">(se abre en una pestaña nueva)</span>
                </a>
              <% }) %>
            </div>
          </div>
          <% } %>
        </div>
      </aside>
    </div>
  </main>

  <!-- Lightbox -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-label="Fotografía ampliada" class="hidden fixed inset-0 z-50 bg-neutral-950/95 items-center justify-center p-2 sm:p-4">
    <button id="lb-close" aria-label="Cerrar" class="absolute top-2 right-2 sm:top-4 sm:right-4 w-10 h-10 sm:w-11 sm:h-11 grid place-items-center rounded-full bg-white/10 hover:bg-white/25 text-white text-2xl leading-none z-10">&times;</button>
    <button id="lb-prev" aria-label="Anterior" class="absolute left-2 sm:left-4 w-10 h-10 sm:w-12 sm:h-12 grid place-items-center rounded-full bg-white/10 hover:bg-white/25 text-white text-3xl sm:text-4xl leading-none z-10">&lsaquo;</button>
    <img id="lb-img" src="" alt="Vista ampliada" class="max-h-[90vh] max-w-[95vw] sm:max-h-[85vh] sm:max-w-[90vw] rounded-lg">
    <button id="lb-next" aria-label="Siguiente" class="absolute right-2 sm:right-4 w-10 h-10 sm:w-12 sm:h-12 grid place-items-center rounded-full bg-white/10 hover:bg-white/25 text-white text-3xl sm:text-4xl leading-none z-10">&rsaquo;</button>
  </div>

  <%- include('partials/footer') %>
  <script>window.ANUNCIO_SLUG = "<%= anuncio.slug %>";</script>
  <script src="/js/anuncio.js" defer></script>
</body>
</html>
