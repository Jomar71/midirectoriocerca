<%
  var titulo = 'DirectorioCerca — Encuentra negocios y servicios cerca de ti';
  var totalGlobal = categorias.reduce(function(s, c){ return s + (c.total_anuncios || 0); }, 0);
  var hayFiltros = !!(filtros.q || filtros.categoria || filtros.departamento || filtros.ciudad || filtros.pais);
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head', { titulo: titulo }) %>
</head>
<body class="bg-white text-neutral-800 dark:bg-slate-900 dark:text-slate-100 font-sans">
  <%- include('partials/header') %>

  <main id="contenido">
  <!-- ── PORTADA + BUSCADOR ──────────────────────────────────────── -->
  <section class="relative overflow-hidden border-b border-neutral-200 dark:border-slate-800 bg-gradient-to-b from-primary-50 via-white to-white dark:from-slate-800 dark:via-slate-900 dark:to-slate-900">
    <div class="absolute inset-0 opacity-70 dark:opacity-20" style="background-image:radial-gradient(circle,#bfdbfe 1px,transparent 1px);background-size:24px 24px" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-3 sm:px-4 py-10 sm:py-14 lg:py-20">
      <div class="dc-rise max-w-3xl min-w-0">
        <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.08] sm:leading-[1.05] text-neutral-900 dark:text-white text-balance break-words">
          Encuentra lo que buscas, cerca de ti.
        </h1>
        <p class="mt-4 sm:mt-5 max-w-xl text-base sm:text-lg leading-relaxed text-neutral-500 dark:text-slate-400 break-words">
          El directorio virtual donde las empresas, microempresas y pymes de Colombia se conectan con sus clientes. Sin complicaciones, sin costos altos.
        </p>

        <div class="mt-6 sm:mt-8 flex flex-wrap gap-x-8 gap-y-4 sm:gap-x-10 sm:gap-y-5">
          <div>
            <p class="font-display text-2xl sm:text-3xl font-bold text-primary-700 dark:text-primary-400 dc-tabular"><%= totalGlobal %></p>
            <p class="text-sm text-neutral-500 dark:text-slate-400">Anuncios publicados</p>
          </div>
          <div>
            <p class="font-display text-2xl sm:text-3xl font-bold text-primary-700 dark:text-primary-400 dc-tabular"><%= categorias.length %></p>
            <p class="text-sm text-neutral-500 dark:text-slate-400">Categorías</p>
          </div>
          <div>
            <p class="font-display text-2xl sm:text-3xl font-bold text-primary-700 dark:text-primary-400 dc-tabular"><%= ubicaciones.ciudades.length %></p>
            <p class="text-sm text-neutral-500 dark:text-slate-400">Ciudades</p>
          </div>
        </div>

        <!-- Barra de búsqueda flotante (una sola pieza) -->
        <div class="dc-rise mt-8 sm:mt-10 w-full max-w-2xl" style="animation-delay:.08s">
          <form action="/resultados" method="get" role="search" aria-label="Buscar en el directorio"
                class="bg-white dark:bg-slate-800 rounded-2xl sm:rounded-full border border-neutral-200 dark:border-slate-700 shadow-xl shadow-primary-950/[0.12] dark:shadow-black/40 p-1.5 sm:p-2 flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-2">
            <div class="relative flex-1 min-w-0">
              <label for="q" class="sr-only">Qué buscas</label>
              <svg class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-primary-600 dark:text-primary-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.2-3.2"/></svg>
              <input id="q" type="text" name="q" value="<%= filtros.q || '' %>" placeholder="¿Qué buscas? (Ej: restaurantes, abogados, talleres)"
                     class="h-12 w-full pl-11 pr-3 rounded-full bg-transparent sm:bg-neutral-100 dark:sm:bg-slate-700/70 border-0 sm:border border-neutral-200 dark:border-slate-600 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500">
            </div>
            <span class="hidden sm:block w-px h-7 bg-neutral-200 dark:bg-slate-600 shrink-0" aria-hidden="true"></span>
            <div class="relative flex-1 min-w-0">
              <label for="ciudad" class="sr-only">Dónde</label>
              <svg class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-primary-600 dark:text-primary-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.6-7-11a7 7 0 1 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
              <input id="ciudad" type="text" name="ciudad" list="ciudades-list" value="<%= filtros.ciudad || '' %>" placeholder="¿Dónde? (Tu ciudad o barrio)"
                     autocomplete="off"
                     class="h-12 w-full pl-11 pr-3 rounded-full bg-transparent sm:bg-neutral-100 dark:sm:bg-slate-700/70 border-0 sm:border border-neutral-200 dark:border-slate-600 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500">
              <datalist id="ciudades-list">
                <% var ciudadesVistas = {}; %>
                <% ubicaciones.ciudades.forEach(function(c){ %>
                  <% if (!ciudadesVistas[c.nombre]) { ciudadesVistas[c.nombre] = 1; %>
                    <option value="<%= c.nombre %>"></option>
                  <% } %>
                <% }) %>
              </datalist>
            </div>
            <button type="submit" class="h-12 shrink-0 px-6 rounded-full bg-primary-600 hover:bg-primary-700 text-white font-bold transition-colors inline-flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.2-3.2"/></svg>
              Buscar
            </button>
          </form>
          <p class="mt-3 text-sm text-neutral-500 dark:text-slate-400"><%= pagination.total %> <%= pagination.total === 1 ? 'resultado' : 'resultados' %> disponibles en el directorio</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CATEGORÍAS ──────────────────────────────────────────────── -->
  <section class="border-b border-neutral-200 dark:border-slate-800 bg-white dark:bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 py-12 lg:py-16">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
        <h2 class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-slate-100">Explora por categoría</h2>
        <% if (hayFiltros) { %>
          <a href="/" class="text-sm font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400">Ver todo el directorio</a>
        <% } %>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <a href="/" class="group flex items-center gap-4 rounded-2xl bg-primary-600 hover:bg-primary-700 p-4 text-white transition-colors">
          <span class="grid place-items-center w-11 h-11 rounded-xl bg-white/15 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.6-7-11a7 7 0 1 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-semibold truncate">Todas las categorías</span>
            <span class="block text-sm text-primary-100"><%= totalGlobal %> anuncios</span>
          </span>
          <svg class="w-5 h-5 text-white/70 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
        </a>

        <% categorias.forEach(function(c){ %>
          <a href="/resultados?categoria=<%= c.slug %>" class="group flex items-center gap-4 rounded-2xl border border-neutral-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-primary-300 dark:hover:border-primary-500 hover:shadow-sm p-4 transition">
            <span class="grid place-items-center w-11 h-11 rounded-xl bg-primary-50 dark:bg-slate-700 text-primary-600 dark:text-primary-400 group-hover:bg-primary-600 group-hover:text-white transition-colors shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.6-7-11a7 7 0 1 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-semibold text-neutral-900 dark:text-white truncate"><%= c.nombre %></span>
              <span class="block text-sm text-neutral-500 dark:text-slate-400"><%= c.total_anuncios %> anuncios</span>
            </span>
            <svg class="w-5 h-5 text-neutral-300 dark:text-slate-500 group-hover:text-primary-600 dark:group-hover:text-primary-400 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ── CONTACTO / ASISTENCIA 24/7 ──────────────────────────────── -->
  <section id="contacto" class="border-t border-neutral-200 dark:border-slate-800 bg-neutral-50 dark:bg-slate-800/60">
    <div class="max-w-6xl mx-auto px-3 sm:px-4 py-10 sm:py-14 lg:py-16">
      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-6 lg:gap-14 items-start">
        <div>
          <h2 class="font-display text-3xl font-semibold tracking-tight text-neutral-900 dark:text-slate-100">Asistencia 24/7</h2>
          <p class="text-neutral-500 dark:text-slate-400 mt-3 leading-relaxed">¿Quieres publicar tu empresa o necesitas ayuda? Escríbenos y te responderemos a la brevedad.</p>
          <ul class="mt-6 space-y-3 text-sm text-neutral-600 dark:text-slate-300">
            <li class="flex items-start gap-3">
              <span class="grid place-items-center w-6 h-6 rounded-full bg-success-100 text-success-700 shrink-0 mt-0.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg></span>
              Publica fotos, datos de contacto y ubicación en el mapa.
            </li>
            <li class="flex items-start gap-3">
              <span class="grid place-items-center w-6 h-6 rounded-full bg-success-100 text-success-700 shrink-0 mt-0.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg></span>
              Aparece en las búsquedas por categoría y ciudad.
            </li>
            <li class="flex items-start gap-3">
              <span class="grid place-items-center w-6 h-6 rounded-full bg-success-100 text-success-700 shrink-0 mt-0.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg></span>
              Promoción local, nacional e internacional.
            </li>
          </ul>
        </div>

        <form id="contacto-form" class="bg-white dark:bg-slate-700 rounded-2xl border border-neutral-200 dark:border-slate-700 shadow-sm p-4 sm:p-7 grid gap-4 sm:grid-cols-2 w-full min-w-0">
          <div class="sm:col-span-2 min-w-0">
            <h3 class="font-semibold text-neutral-900 dark:text-slate-100 break-words">Cuéntanos qué necesitas</h3>
            <p class="text-sm text-neutral-500 dark:text-slate-400 mt-0.5 break-words">Te respondemos por email.</p>
          </div>
          <input name="nombre" required placeholder="Tu nombre" aria-label="Tu nombre" autocomplete="name" class="h-11 px-4 rounded-xl bg-neutral-100 dark:bg-slate-600 border border-neutral-200 dark:border-slate-500 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500 w-full min-w-0">
          <input name="email" type="email" required placeholder="Tu email" aria-label="Tu email" autocomplete="email" class="h-11 px-4 rounded-xl bg-neutral-100 dark:bg-slate-600 border border-neutral-200 dark:border-slate-500 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500 w-full min-w-0">
          <input name="telefono" type="tel" inputmode="tel" placeholder="Teléfono (opcional)" aria-label="Teléfono" autocomplete="tel" class="sm:col-span-2 h-11 px-4 rounded-xl bg-neutral-100 dark:bg-slate-600 border border-neutral-200 dark:border-slate-500 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500 w-full min-w-0">
          <textarea name="mensaje" required rows="4" placeholder="Escribe tu mensaje..." aria-label="Mensaje" class="sm:col-span-2 px-4 py-3 rounded-xl bg-neutral-100 dark:bg-slate-600 border border-neutral-200 dark:border-slate-500 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500 w-full min-w-0 resize-y"></textarea>
          <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
            <button type="submit" class="px-6 h-11 grid place-items-center rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-bold transition-colors whitespace-nowrap">Enviar mensaje</button>
            <span id="contacto-msg" class="text-sm break-words" role="status"></span>
          </div>
        </form>
      </div>
    </div>
  </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/index.js" defer></script>
</body>
</html>
