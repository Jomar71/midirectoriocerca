<%
  var titulo = 'DirectorioCerca — Encuentra negocios y servicios cerca de ti';
  var totalGlobal = categorias.reduce(function(s, c){ return s + (c.total_anuncios || 0); }, 0);
  var hayFiltros = !!(filtros.q || filtros.categoria || filtros.departamento || filtros.ciudad || filtros.pais);
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head', { titulo: titulo }) %>
</head>
<body class="bg-white text-neutral-800 dark:bg-slate-900 dark:text-slate-100 font-sans">
  <%- include('partials/header') %>

  <main id="contenido">
  <!-- ── PORTADA + BUSCADOR ──────────────────────────────────────── -->
  <section class="relative overflow-hidden border-b border-neutral-200 dark:border-slate-800">
    <div class="absolute inset-0" data-ripple data-ripple-image="/img/inicio.jpg">
      <img src="/img/inicio.jpg" alt="" aria-hidden="true" fetchpriority="high" decoding="async"
           class="absolute inset-0 w-full h-full object-cover object-center">
      <canvas class="dc-ripple-canvas" hidden aria-hidden="true"></canvas>
    </div>
    <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-primary-950/90 via-primary-900/65 to-primary-800/20 dark:from-primary-950/90 dark:via-primary-950/70 dark:to-slate-900/40" aria-hidden="true"></div>
    <div class="absolute inset-0 pointer-events-none opacity-[0.07]" style="background-image:radial-gradient(circle,#ffffff 1px,transparent 1px);background-size:24px 24px" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-3 sm:px-4 py-14 sm:py-20 lg:py-28">
      <div class="max-w-2xl min-w-0">
        <p class="text-xs sm:text-sm font-bold uppercase tracking-[0.22em] text-accent-400">Directorio de negocios de Colombia</p>
        <h1 class="dc-rise mt-4 font-display text-3xl sm:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.08] sm:leading-[1.05] text-white text-balance break-words">
          Encuentra lo que buscas, cerca de ti.
        </h1>
        <p class="dc-rise mt-4 sm:mt-5 max-w-xl text-base sm:text-lg leading-relaxed text-primary-100/90 break-words" style="animation-delay:.05s">
          El directorio virtual donde las empresas, microempresas y pymes de Colombia se conectan con sus clientes. Sin complicaciones, sin costos altos.
        </p>

        <!-- Barra de búsqueda flotante (una sola pieza) -->
        <div class="dc-rise mt-8 sm:mt-10 w-full max-w-2xl" style="animation-delay:.1s">
          <form action="/resultados" method="get" role="search" aria-label="Buscar en el directorio"
                class="bg-white dark:bg-slate-800 rounded-2xl sm:rounded-full border border-white/20 shadow-xl shadow-primary-950/30 p-1.5 sm:p-2 flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-2">
            <div class="relative flex-1 min-w-0">
              <label for="q" class="sr-only">Qué buscas</label>
              <svg class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-primary-600 dark:text-primary-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.2-3.2"/></svg>
              <input id="q" type="text" name="q" value="<%= filtros.q || '' %>" placeholder="¿Qué buscas? (Ej: restaurantes, abogados, talleres)"
                     class="h-12 w-full pl-11 pr-3 rounded-xl sm:rounded-full bg-neutral-100 sm:bg-neutral-100 dark:bg-slate-700/70 border border-neutral-200 sm:border-neutral-200 dark:border-slate-600 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500">
            </div>
            <span class="hidden sm:block w-px h-7 bg-neutral-200 dark:bg-slate-600 shrink-0" aria-hidden="true"></span>
            <div class="relative flex-1 min-w-0">
              <label for="ciudad" class="sr-only">Dónde</label>
              <svg class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-primary-600 dark:text-primary-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.6-7-11a7 7 0 1 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
              <input id="ciudad" type="text" name="ciudad" list="ciudades-list" value="<%= filtros.ciudad || '' %>" placeholder="¿Dónde? (Tu ciudad o barrio)"
                     autocomplete="off"
                     class="h-12 w-full pl-11 pr-3 rounded-xl sm:rounded-full bg-neutral-100 sm:bg-neutral-100 dark:bg-slate-700/70 border border-neutral-200 sm:border-neutral-200 dark:border-slate-600 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500">
              <datalist id="ciudades-list">
                <% ubicaciones.ciudades.forEach(function(c){ %>
                  <option value="<%= c.nombre %>"><%= c.departamento_nombre %><% if (c.es_capital) { %> · capital<% } %></option>
                <% }) %>
              </datalist>
            </div>
            <button type="submit" class="h-12 shrink-0 px-6 rounded-xl sm:rounded-full bg-primary-600 hover:bg-primary-700 text-white font-bold transition-colors inline-flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.2-3.2"/></svg>
              Buscar
            </button>
          </form>
        </div>

        <dl class="mt-8 sm:mt-10 flex flex-wrap gap-x-8 gap-y-4 sm:gap-x-12">
          <div>
            <dt class="sr-only">Anuncios publicados</dt>
            <dd class="font-display text-2xl sm:text-3xl font-bold text-white dc-tabular"><%= totalGlobal %></dd>
            <dt class="text-sm text-primary-200/80">Anuncios publicados</dt>
          </div>
          <div>
            <dt class="sr-only">Categorías</dt>
            <dd class="font-display text-2xl sm:text-3xl font-bold text-white dc-tabular"><%= categorias.length %></dd>
            <dt class="text-sm text-primary-200/80">Categorías</dt>
          </div>
          <div>
            <dt class="sr-only">Ciudades</dt>
            <dd class="font-display text-2xl sm:text-3xl font-bold text-white dc-tabular"><%= ubicaciones.ciudades.length %></dd>
            <dt class="text-sm text-primary-200/80">Ciudades</dt>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ── CATEGORÍAS ──────────────────────────────────────────────── -->
  <section class="border-b border-neutral-200 dark:border-slate-800 bg-white dark:bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 py-12 lg:py-16">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
        <h2 class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-slate-100">Explora por categoría</h2>
        <% if (hayFiltros) { %>
          <a href="/resultados" class="text-sm font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400">Ver todo el directorio</a>
        <% } %>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <a href="/resultados" class="group flex items-center gap-4 rounded-2xl bg-primary-600 hover:bg-primary-700 p-4 text-white transition-colors">
          <span class="grid place-items-center w-11 h-11 rounded-xl bg-white/15 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.6-7-11a7 7 0 1 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-semibold truncate">Todas las categorías</span>
            <span class="block text-sm text-primary-100"><%= totalGlobal %> anuncios</span>
          </span>
          <svg class="w-5 h-5 text-white/70 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
        </a>

        <% categorias.forEach(function(c){ %>
          <a href="/resultados?categoria=<%= c.slug %>" class="group flex items-center gap-4 rounded-2xl border border-neutral-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-primary-300 dark:hover:border-primary-500 hover:shadow-sm p-4 transition">
            <span class="grid place-items-center w-11 h-11 rounded-xl bg-primary-50 dark:bg-slate-700 text-primary-600 dark:text-primary-400 group-hover:bg-primary-600 group-hover:text-white transition-colors shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.6-7-11a7 7 0 1 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-semibold text-neutral-900 dark:text-white truncate"><%= c.nombre %></span>
              <span class="block text-sm text-neutral-500 dark:text-slate-400"><%= c.total_anuncios %> anuncios</span>
            </span>
            <svg class="w-5 h-5 text-neutral-300 dark:text-slate-500 group-hover:text-primary-600 dark:group-hover:text-primary-400 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ── PAUTA CON NOSOTROS ──────────────────────────────────────── -->
  <section id="contacto" class="border-t border-primary-800 bg-primary-950" aria-labelledby="pauta-titulo">
    <div class="relative overflow-hidden border-b border-white/10">
      <div class="absolute inset-0" data-ripple data-ripple-image="/img/call-center.jpg">
        <img src="/img/call-center.jpg" alt="" aria-hidden="true" loading="lazy" decoding="async"
             class="absolute inset-0 w-full h-full object-cover object-center">
        <canvas class="dc-ripple-canvas" hidden aria-hidden="true"></canvas>
      </div>
      <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-primary-950/90 via-primary-900/65 to-primary-800/20 dark:from-primary-950/90 dark:via-primary-950/70 dark:to-slate-900/40" aria-hidden="true"></div>
      <div class="absolute inset-0 pointer-events-none opacity-[0.07]" style="background-image:radial-gradient(circle,#ffffff 1px,transparent 1px);background-size:24px 24px" aria-hidden="true"></div>

      <div class="relative max-w-6xl mx-auto px-3 sm:px-4 py-14 sm:py-20 lg:py-24">
        <div class="max-w-2xl min-w-0">
          <div class="flex items-center gap-3">
            <span class="h-px w-8 bg-accent-400" aria-hidden="true"></span>
            <p class="text-sm font-semibold text-accent-300">Pauta con nosotros</p>
          </div>
          <h2 id="pauta-titulo" class="mt-5 font-display text-4xl sm:text-5xl lg:text-[3.4rem] font-semibold tracking-tight leading-[1.08] text-white text-balance">
            Afíliate hoy: 3 años de beneficios por un solo pago $374.900.
          </h2>
          <p class="mt-5 text-lg sm:text-xl font-semibold leading-snug text-accent-300">
            ¡Aprovecha esta promoción y asegura tu lugar ahora!
          </p>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-primary-100/90 break-words">
            Si tienes una Empresa, Actividad Comercial, ofreces un Producto o un Servicio y deseas aumentar tus Ventas y Beneficios dándote a conocer a nivel Local, Regional, Nacional, puedes anunciarlo en www.midirectoriocerca.com
          </p>
          <a href="#contacto-form" class="mt-7 inline-flex items-center justify-center h-12 px-6 rounded-xl bg-accent-400 hover:bg-accent-300 text-neutral-900 font-extrabold shadow-lg shadow-accent-600/20 transition-colors">
            Solicitar afiliación
          </a>
        </div>
      </div>
    </div>

    <div id="beneficios" class="max-w-6xl mx-auto px-3 sm:px-4 py-12 sm:py-14 lg:py-16">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-14">
        <div class="lg:col-span-7 min-w-0">
          <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-white">Este valor incluye</h3>
          <p class="mt-3 max-w-xl text-sm sm:text-base leading-relaxed text-primary-200/90">
            Una ficha completa para que tus clientes encuentren tu empresa, la conozcan y te contacten.
          </p>
          <ul class="mt-6 sm:mt-7 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 text-sm leading-snug text-primary-100">
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-primary-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
              <span><strong class="font-semibold text-white">7 fotografías</strong> de tu Empresa.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-primary-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
              <span><strong class="font-semibold text-white">50 palabras</strong> de texto del Portafolio Empresarial.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-primary-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
              <span>Datos direccionales, teléfonos fijos y móviles + correos electrónicos.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-primary-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
              <span>Enlace a tu página web y redes sociales: WhatsApp, Facebook, Twitter, Instagram y YouTube (si las tuvieses).</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-primary-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
              <span>Formulario de contacto.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-primary-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
              <span>Transcripción a todos los idiomas del mundo.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-primary-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
              <span>Mapa de ubicación geo-satelital.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-primary-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
              <span><strong class="font-semibold text-white">10 palabras clave</strong> de búsqueda relacionadas con la razón social.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-primary-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
              <span><strong class="font-semibold text-white">7 cambios gratis</strong> durante el año, en la información y fotos del anuncio.</span>
            </li>
            <li class="flex items-start gap-2.5 sm:col-span-2">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-primary-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
              <span>Subdominio web de tu empresa: <span class="font-medium text-primary-200 break-all">www.midirectoriocerca.com/tuempresa</span></span>
            </li>
          </ul>
        </div>

        <div class="lg:col-span-5 min-w-0">
          <form id="contacto-form" class="lg:sticky lg:top-24 rounded-2xl bg-white p-5 sm:p-6 lg:p-7 grid gap-4 sm:grid-cols-2 w-full min-w-0 shadow-2xl shadow-primary-950/50">
            <div class="sm:col-span-2 min-w-0">
              <h3 class="font-display text-2xl sm:text-3xl font-semibold tracking-tight leading-tight text-neutral-900 text-balance">
                Solicita tu afiliación
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-600">Déjanos tus datos y te contactamos para activar tu anuncio.</p>
            </div>
            <div class="min-w-0">
              <label for="pauta-nombre" class="sr-only">Tu nombre</label>
              <input id="pauta-nombre" name="nombre" required placeholder="Tu nombre" autocomplete="name" class="h-11 px-4 rounded-xl bg-neutral-50 border border-neutral-300 text-neutral-900 placeholder:text-neutral-600 focus:outline-none focus:ring-2 focus:ring-primary-600 w-full min-w-0">
            </div>
            <div class="min-w-0">
              <label for="pauta-email" class="sr-only">Tu email</label>
              <input id="pauta-email" name="email" type="email" required placeholder="Tu email" autocomplete="email" class="h-11 px-4 rounded-xl bg-neutral-50 border border-neutral-300 text-neutral-900 placeholder:text-neutral-600 focus:outline-none focus:ring-2 focus:ring-primary-600 w-full min-w-0">
            </div>
            <div class="sm:col-span-2 min-w-0">
              <label for="pauta-telefono" class="sr-only">Teléfono (opcional)</label>
              <input id="pauta-telefono" name="telefono" type="tel" inputmode="tel" placeholder="Teléfono (opcional)" autocomplete="tel" class="h-11 px-4 rounded-xl bg-neutral-50 border border-neutral-300 text-neutral-900 placeholder:text-neutral-600 focus:outline-none focus:ring-2 focus:ring-primary-600 w-full min-w-0">
            </div>
            <div class="sm:col-span-2 min-w-0">
              <label for="pauta-mensaje" class="sr-only">Mensaje</label>
              <textarea id="pauta-mensaje" name="mensaje" required rows="4" placeholder="Cuéntanos sobre tu empresa y qué necesitas..." class="px-4 py-3 rounded-xl bg-neutral-50 border border-neutral-300 text-neutral-900 placeholder:text-neutral-600 focus:outline-none focus:ring-2 focus:ring-primary-600 w-full min-w-0 resize-y"></textarea>
            </div>
            <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
              <button type="submit" class="px-6 h-12 grid place-items-center rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-bold transition-colors whitespace-nowrap">Enviar solicitud</button>
              <span id="contacto-msg" class="text-sm break-words" role="status"></span>
            </div>
            <div class="sm:col-span-2 border-t border-neutral-200 pt-4">
              <p class="text-xs font-bold uppercase tracking-wider text-neutral-500">¿Prefieres contactarnos directo?</p>
              <div class="mt-2.5 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold">
                <a href="mailto:midirectoriocerca@proton.me" class="inline-flex items-center gap-2 text-neutral-700 hover:text-primary-700 transition-colors">
                  <svg class="w-4 h-4 shrink-0 text-primary-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6"/></svg>
                  <span class="break-all">midirectoriocerca@proton.me</span>
                </a>
                <a href="https://wa.me/573053033903" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-neutral-700 hover:text-primary-700 transition-colors">
                  <svg class="w-4 h-4 shrink-0 text-whatsapp" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.5 3.8 8 3.1l1.5 4-1.7 1.3a13 13 0 0 0 6.8 6.8l1.3-1.7 4 1.5-.7 1.5A2.3 2.3 0 0 1 16.9 18.6 16 16 0 0 1 5.4 7.1 2.3 2.3 0 0 1 6.5 3.8Z"/></svg>
                  <span>+57 305 303 3903</span>
                  <span class="sr-only">(se abre en una pestaña nueva)</span>
                </a>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-3 sm:px-4 pb-14 sm:pb-16">
      <div class="border-t border-white/10 pt-8 sm:pt-10 grid lg:grid-cols-12 gap-8">
        <div class="lg:col-span-4 min-w-0">
          <h3 class="font-display text-2xl sm:text-3xl font-semibold tracking-tight leading-tight text-white text-balance">Potencia tu presencia digital</h3>
          <p class="mt-3 text-sm leading-relaxed text-primary-200/90">
            Descubre nuestros servicios opcionales: calidad y comodidad a precios accesibles. Elige lo que tu negocio necesita para destacar.
          </p>
          <a href="#contacto-form" class="inline-block mt-4 text-sm font-semibold text-accent-300 hover:text-accent-200 underline underline-offset-4 decoration-accent-400/50">
            Consulta hoy mismo y encuentra la opción perfecta para ti
          </a>
        </div>

        <ul class="lg:col-span-8 grid sm:grid-cols-2 gap-x-10">
          <li class="border-t border-white/15 pt-4">
            <h4 class="font-semibold text-white">Tarjeta digital de presentación</h4>
            <p class="mt-1 text-sm leading-relaxed text-primary-200/90">Comparte tus datos de forma moderna y profesional.</p>
          </li>
          <li class="border-t border-white/15 pt-4">
            <h4 class="font-semibold text-white">Elaboración de páginas web</h4>
