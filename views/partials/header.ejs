<%
  // Partial: banner superior (marca + CTA de contacto/suscripción) + traductor de Google + modo oscuro.
%>
<a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-3 focus:left-3 focus:bg-white focus:text-primary-800 focus:px-4 focus:py-2 focus:rounded-xl focus:font-bold focus:shadow-lg">Saltar al contenido</a>
<header class="sticky top-0 z-40 text-white shadow-lg shadow-primary-950/30 bg-gradient-to-r from-primary-950 via-primary-900 to-primary-800">
  <!-- Textura de puntos -->
  <div class="absolute inset-0 opacity-[0.12]" style="background-image:radial-gradient(circle,#ffffff 1px,transparent 1px);background-size:22px 22px" aria-hidden="true"></div>
  <!-- Acento superior -->
  <div class="relative h-0.5 bg-gradient-to-r from-transparent via-accent-400 to-transparent" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-3 sm:px-4 h-14 sm:h-[68px] flex items-center gap-2 sm:gap-3 min-w-0">
    <!-- Marca / logo -->
    <a href="/" class="flex items-center gap-2 sm:gap-2.5 shrink-0 group" aria-label="DirectorioCerca - Inicio">
      <span class="grid place-items-center w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white text-primary-800 font-display font-extrabold text-lg sm:text-xl shadow-md transition-transform duration-200 group-hover:-rotate-3">D</span>
      <span class="font-display font-bold text-base sm:text-[22px] tracking-tight leading-none truncate" translate="no">Directorio<span class="italic text-accent-400">Cerca</span></span>
    </a>

    <!-- Mensaje centrado que motiva la acción -->
    <div class="hidden lg:flex flex-1 min-w-0 justify-center text-center pointer-events-none px-2">
      <div class="max-w-md truncate">
        <p class="text-[9px] xl:text-[10px] font-bold uppercase tracking-[0.2em] xl:tracking-[0.22em] text-accent-300">Publicidad 24/7</p>
        <p class="text-[11px] xl:text-[13px] font-medium text-primary-100/90 mt-0.5 truncate">¿Tienes un negocio? Muéstralo y vende más</p>
      </div>
    </div>

    <div class="flex-1 lg:hidden"></div>

    <!-- CTA principal: llama y suscríbete -->
    <a href="/#contacto" class="inline-flex items-center gap-1.5 sm:gap-2 h-9 sm:h-11 px-2.5 sm:px-5 rounded-xl bg-accent-400 hover:bg-accent-300 text-neutral-900 font-extrabold text-xs sm:text-sm shadow-lg shadow-black/20 transition-colors whitespace-nowrap">
      <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/></svg>
      <span class="hidden sm:inline">Llama y suscríbete</span>
      <span class="sm:hidden">Suscríbete</span>
    </a>

    <!-- Traducción a todos los idiomas (Google Translate) -->
    <div class="hidden lg:block shrink-0">
      <div id="google_translate_element"></div>
    </div>

    <!-- Interruptor de modo oscuro -->
    <button id="theme-toggle" type="button" aria-label="Cambiar tema claro/oscuro" class="w-9 h-9 sm:w-10 sm:h-10 grid place-items-center rounded-xl text-white hover:bg-white/15 transition-colors shrink-0">
      <svg id="theme-moon" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      <svg id="theme-sun" class="w-4 h-4 sm:w-5 sm:h-5 hidden" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>

  <!-- Menú principal -->
  <nav class="relative border-t border-white/10 bg-primary-950/50" aria-label="Menú principal">
    <div class="max-w-7xl mx-auto px-3 sm:px-4 flex items-center gap-1 sm:gap-2 overflow-x-auto text-xs sm:text-sm font-semibold whitespace-nowrap" style="scrollbar-width:none">
      <a href="/" class="shrink-0 px-2.5 sm:px-3 py-2 rounded-lg text-primary-100 hover:text-white hover:bg-white/10 transition-colors">Inicio</a>
      <a href="/nosotros" class="shrink-0 px-2.5 sm:px-3 py-2 rounded-lg text-primary-100 hover:text-white hover:bg-white/10 transition-colors">Nosotros</a>
      <a href="/contacto" class="shrink-0 px-2.5 sm:px-3 py-2 rounded-lg text-primary-100 hover:text-white hover:bg-white/10 transition-colors">Contáctanos</a>
    </div>
  </nav>
</header>

<script type="text/javascript">
  function googleTranslateElementInit() {
    new google.translate.TranslateElement(
      { pageLanguage: 'es', autoDisplay: false, layout: google.translate.TranslateElement.InlineLayout.SIMPLE },
      'google_translate_element'
    );
  }
</script>
<script type="text/javascript" src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
<script>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    var sun = document.getElementById('theme-sun');
    var moon = document.getElementById('theme-moon');
    function paint() {
      var dark = document.documentElement.classList.contains('dark');
      sun.classList.toggle('hidden', dark);
      moon.classList.toggle('hidden', !dark);
    }
    btn.addEventListener('click', function () {
      var dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('dc-theme', dark ? 'dark' : 'light'); } catch (e) {}
      paint();
    });
    paint();
  })();
</script>
