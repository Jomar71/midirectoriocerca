<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="format-detection" content="telephone=no">
<title><%= (typeof titulo !== 'undefined' && titulo) ? titulo : 'DirectorioCerca — Directorio de negocios' %></title>

<!-- PWA -->
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#2563eb">
<link rel="apple-touch-icon" href="/img/icon-192.png">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">

<!-- Tipografías: Fraunces (display) + Manrope (interfaz) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  // Sistema de diseño DirectorioCerca — tokens corporativos.
  // Los valores son las escalas Tailwind estándar que coinciden 1:1 con la
  // paleta de marca (ver README). Uso en modo oscuro: escala slate.
  tailwind.config = {
    darkMode: 'class',
    theme: {
      extend: {
        screens: {
          xs: '380px'
        },
        colors: {
          // 1. Color primario — Azul Confianza
          primary: {
            50: '#EFF6FF', 100: '#DBEAFE', 200: '#BFDBFE', 300: '#93C5FD',
            400: '#60A5FA', 500: '#3B82F6', 600: '#2563EB', 700: '#1D4ED8',
            800: '#1E40AF', 900: '#1E3A8A', 950: '#172554'
          },
          // 2. Acento — Amarillo Cercanía
          accent: {
            50: '#FEFCE8', 100: '#FEF9C3', 200: '#FEF08A', 300: '#FDE047',
            400: '#FACC15', 500: '#EAB308', 600: '#CA8A04', 700: '#A16207',
            800: '#854D0E', 900: '#713F12'
          },
          // 3. Éxito — Verde Verificado
          success: {
            50: '#ECFDF5', 100: '#D1FAE5', 200: '#A7F3D0', 300: '#6EE7B7',
            400: '#34D399', 500: '#10B981', 600: '#059669', 700: '#047857',
            800: '#065F46', 900: '#064E3B'
          },
          // 4. Estados
          warning: { 50: '#FFFBEB', 500: '#F59E0B', 600: '#D97706', 700: '#B45309' },
          error: { 50: '#FEF2F2', 500: '#EF4444', 600: '#DC2626', 700: '#B91C1C' },
          info: { 50: '#F0F9FF', 500: '#0EA5E9', 600: '#0284C7', 700: '#0369A1' },
          // 5. Neutros
          neutral: {
            50: '#F9FAFB', 100: '#F3F4F6', 200: '#E5E7EB', 300: '#D1D5DB',
            400: '#9CA3AF', 500: '#6B7280', 600: '#4B5563', 700: '#374151',
            800: '#1F2937', 900: '#111827'
          },
          // 6. Semánticos específicos del directorio
          verified: { bg: '#ECFDF5', text: '#047857' },
          featured: { bg: '#EFF6FF', text: '#1D4ED8' },
          distance: { bg: '#F3F4F6', text: '#4B5563' },
          open: '#059669',
          closed: '#DC2626',
          rating: '#FACC15',
          whatsapp: { DEFAULT: '#25D366', hover: '#1DA851' }
        },
        fontFamily: {
          sans: ['Manrope', 'system-ui', 'sans-serif'],
          display: ['Fraunces', 'Georgia', 'serif'],
          serif: ['Fraunces', 'Georgia', 'serif']
        }
      }
    }
  };
</script>
<script>
  // Aplica el tema guardado (o el del sistema) antes del primer pintado.
  (function () {
    try {
      var t = localStorage.getItem('dc-theme');
      var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (dark) document.documentElement.classList.add('dark');
    } catch (e) {}
  })();
</script>
<link rel="stylesheet" href="/css/styles.css">