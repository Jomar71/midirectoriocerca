<%
  var titulo = (typeof title !== 'undefined' && title) ? title : 'Resultados de búsqueda | DirectorioCerca';
  var hayFiltros = !!(filtros.q || filtros.categoria || filtros.departamento || filtros.ciudad || filtros.pais);

  var buildFilterUrl = function(removeKey) {
    var params = new URLSearchParams();
    if (filtros.q && removeKey !== 'q') params.set('q', filtros.q);
    if (filtros.categoria && removeKey !== 'categoria') params.set('categoria', filtros.categoria);
    if (filtros.ciudad && removeKey !== 'ciudad') params.set('ciudad', filtros.ciudad);
    if (filtros.departamento && removeKey !== 'departamento') params.set('departamento', filtros.departamento);
    var qs = params.toString();
    return '/resultados' + (qs ? '?' + qs : '');
  };
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head', { titulo: titulo }) %>
</head>
<body class="bg-white text-neutral-800 dark:bg-slate-900 dark:text-slate-100 font-sans">
  <%- include('partials/header') %>

  <main id="contenido">
    <!-- ── BARRA DE BÚSQUEDA Y CATEGORÍAS ──────────────────────────── -->
    <section class="relative border-b border-neutral-200 dark:border-slate-800 bg-gradient-to-b from-primary-50 via-white to-white dark:from-slate-800 dark:via-slate-900 dark:to-slate-900">
      <div class="relative max-w-7xl mx-auto px-3 sm:px-4 pt-6 sm:pt-8 pb-4">
        <!-- Buscador flotante -->
        <form action="/resultados" method="get" role="search" aria-label="Buscar en el directorio"
              class="bg-white dark:bg-slate-800 rounded-2xl sm:rounded-full border border-neutral-200 dark:border-slate-700 shadow-md p-1.5 sm:p-2 flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-2 max-w-4xl mx-auto">
          <div class="relative flex-1 min-w-0">
            <label for="q" class="sr-only">Qué buscas</label>
            <svg class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-primary-600 dark:text-primary-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.2-3.2"/></svg>
            <input id="q" type="text" name="q" value="<%= filtros.q || '' %>" placeholder="¿Qué buscas? (restaurantes, abogados...)"
                   class="h-11 sm:h-12 w-full pl-11 pr-3 rounded-xl sm:rounded-full bg-neutral-100 dark:bg-slate-700/70 border border-neutral-200 dark:border-slate-600 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500 text-sm sm:text-base">
          </div>
          <span class="hidden sm:block w-px h-7 bg-neutral-200 dark:bg-slate-600 shrink-0" aria-hidden="true"></span>
          <div class="relative flex-1 min-w-0">
            <label for="ciudad" class="sr-only">Dónde</label>
            <svg class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-primary-600 dark:text-primary-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.6-7-11a7 7 0 1 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
            <input id="ciudad" type="text" name="ciudad" list="ciudades-list" value="<%= filtros.ciudad || '' %>" placeholder="¿Dónde? (Ciudad o municipio)"
                   autocomplete="off"
                   class="h-11 sm:h-12 w-full pl-11 pr-3 rounded-xl sm:rounded-full bg-neutral-100 dark:bg-slate-700/70 border border-neutral-200 dark:border-slate-600 text-neutral-900 dark:text-slate-100 placeholder:text-neutral-600 dark:placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:focus:ring-primary-500 text-sm sm:text-base">
            <datalist id="ciudades-list">
              <% (ubicaciones.ciudades || []).forEach(function(c){ %>
                <option value="<%= c.nombre %>"><%= c.departamento_nombre %><% if (c.es_capital) { %> · capital<% } %></option>
              <% }) %>
            </datalist>
          </div>
          <% if (filtros.categoria) { %><input type="hidden" name="categoria" value="<%= filtros.categoria %>"><% } %>
          <button type="submit" class="h-11 sm:h-12 shrink-0 px-6 rounded-xl sm:rounded-full bg-primary-600 hover:bg-primary-700 text-white font-bold transition-colors inline-flex items-center justify-center gap-2 shadow-sm text-sm sm:text-base">
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.2-3.2"/></svg>
            Buscar
          </button>
        </form>

        <!-- Barra de categorías rápida (chips deslizables horizontalmente) -->
        <% if (typeof categorias !== 'undefined' && categorias && categorias.length) { %>
          <div class="mt-5 max-w-5xl mx-auto flex items-center gap-1.5 overflow-x-auto pb-2 scroll-smooth" style="scrollbar-width:none" aria-label="Filtrar por categoría">
            <a href="<%= buildFilterUrl('categoria') %>"
               class="shrink-0 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold transition-colors <%= !filtros.categoria ? 'bg-primary-600 text-white shadow-sm' : 'bg-neutral-100 dark:bg-slate-800 text-neutral-700 dark:text-slate-300 hover:bg-neutral-200 dark:hover:bg-slate-700 border border-neutral-200 dark:border-slate-700' %>">
              Todas
            </a>
            <% categorias.forEach(function(c){ %>
              <%
                var isSelected = filtros.categoria === c.slug;
                var catUrl = isSelected ? buildFilterUrl('categoria') : '/resultados?' + (queryString ? queryString.replace(/&?categoria=[^&]*/, '') + (queryString.replace(/&?categoria=[^&]*/, '') ? '&' : '') : '') + 'categoria=' + c.slug;
              %>
              <a href="<%= catUrl %>"
                 class="shrink-0 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold transition-colors <%= isSelected ? 'bg-primary-600 text-white shadow-sm' : 'bg-neutral-100 dark:bg-slate-800 text-neutral-700 dark:text-slate-300 hover:bg-neutral-200 dark:hover:bg-slate-700 border border-neutral-200 dark:border-slate-700' %>">
                <%= c.nombre %>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>

    <!-- ── RESULTADOS ──────────────────────────────────────────────── -->
    <section class="max-w-7xl mx-auto px-3 sm:px-4 py-8 sm:py-12">
      <!-- Encabezado de resultados y chips activos -->
      <div class="mb-6 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-neutral-200 dark:border-slate-800 pb-5">
        <div class="min-w-0">
          <nav class="flex items-center text-xs text-neutral-500 dark:text-slate-400 mb-2 gap-1.5" aria-label="Miga de pan">
            <a href="/" class="hover:text-primary-600 dark:hover:text-primary-400">Inicio</a>
            <span>/</span>
            <span class="text-neutral-800 dark:text-slate-200 font-medium">Resultados</span>
            <% if (typeof categoriaActual !== 'undefined' && categoriaActual) { %>
              <span>/</span>
              <span class="text-primary-600 dark:text-primary-400 font-semibold"><%= categoriaActual.nombre %></span>
            <% } %>
          </nav>
          <h1 class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-slate-100 break-words">
            <% if (filtros.q && typeof categoriaActual !== 'undefined' && categoriaActual) { %>
              «<%= filtros.q %>» en <%= categoriaActual.nombre %>
            <% } else if (filtros.q) { %>
              Resultados para «<%= filtros.q %>»
            <% } else if (typeof categoriaActual !== 'undefined' && categoriaActual) { %>
              <%= categoriaActual.nombre %>
            <% } else if (filtros.ciudad) { %>
              Negocios en <%= filtros.ciudad %>
            <% } else { %>
              Directorio de empresas y servicios
            <% } %>
          </h1>
          <p class="text-sm text-neutral-500 dark:text-slate-400 mt-1">
            <%= pagination.total %> <%= pagination.total === 1 ? 'anuncio disponible' : 'anuncios disponibles' %>
          </p>
        </div>

        <!-- Filtros activos con botón de remover -->
        <% if (hayFiltros) { %>
          <div class="flex flex-wrap items-center gap-2">
            <% if (filtros.q) { %>
              <a href="<%= buildFilterUrl('q') %>" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary-100 text-primary-800 dark:bg-primary-950 dark:text-primary-200 hover:bg-primary-200 dark:hover:bg-primary-900 transition-colors" title="Quitar filtro de búsqueda">
                <span>Buscar: «<%= filtros.q %>»</span>
                <span class="text-sm font-bold leading-none">&times;</span>
              </a>
            <% } %>
            <% if (typeof categoriaActual !== 'undefined' && categoriaActual) { %>
              <a href="<%= buildFilterUrl('categoria') %>" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent-100 text-accent-900 dark:bg-accent-950 dark:text-accent-200 hover:bg-accent-200 dark:hover:bg-accent-900 transition-colors" title="Quitar filtro de categoría">
                <span>Categoría: <%= categoriaActual.nombre %></span>
                <span class="text-sm font-bold leading-none">&times;</span>
              </a>
            <% } %>
            <% if (filtros.ciudad) { %>
              <a href="<%= buildFilterUrl('ciudad') %>" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-neutral-200 text-neutral-800 dark:bg-slate-700 dark:text-slate-200 hover:bg-neutral-300 dark:hover:bg-slate-600 transition-colors" title="Quitar filtro de ciudad">
                <span>Ciudad: <%= filtros.ciudad %></span>
                <span class="text-sm font-bold leading-none">&times;</span>
              </a>
            <% } %>
            <a href="/resultados" class="inline-flex items-center h-8 px-3 rounded-lg text-xs font-semibold border border-primary-600 text-primary-600 hover:bg-primary-50 hover:border-primary-700 dark:border-primary-400 dark:text-primary-400 dark:hover:bg-primary-500/10 transition-colors whitespace-nowrap">
              Limpiar todo
            </a>
          </div>
        <% } %>
      </div>

      <!-- Tarjetas de resultados o estado vacío -->
      <% if (anuncios.length === 0) { %>
        <div class="bg-white dark:bg-slate-800 border border-neutral-200 dark:border-slate-700 rounded-2xl px-6 py-16 text-center max-w-xl mx-auto my-8 shadow-sm">
          <span class="inline-grid place-items-center w-14 h-14 rounded-2xl bg-neutral-100 dark:bg-slate-700 text-neutral-500 dark:text-slate-400 mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.2-3.2"/></svg>
          </span>
          <p class="font-display text-2xl font-semibold text-neutral-900 dark:text-slate-100">No encontramos anuncios con esos filtros</p>
          <p class="text-neutral-500 dark:text-slate-400 mt-2 max-w-md mx-auto text-sm leading-relaxed">Prueba con otras palabras clave, selecciona otra categoría o revisa la ciudad.</p>
          <a href="/resultados" class="inline-grid place-items-center h-11 px-6 mt-6 rounded-xl bg-accent-400 text-neutral-900 font-bold hover:bg-accent-500 transition-colors shadow-sm text-sm">
            Ver todos los anuncios
          </a>
        </div>
      <% } else { %>
        <div class="grid gap-4 sm:gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          <% anuncios.forEach(function(a){ %>
            <article class="group flex flex-col overflow-hidden rounded-2xl border border-neutral-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-primary-400 dark:hover:border-primary-500 hover:shadow-xl hover:shadow-primary-950/[0.08] dark:hover:shadow-black/40 transition-all duration-200 min-w-0">
              <a href="/anuncio/<%= a.slug %>" class="block aspect-[4/3] overflow-hidden bg-neutral-100 dark:bg-slate-700 relative group-hover:opacity-95" aria-label="Ver ficha de <%= a.razon_social %>">
                <img src="<%= a.foto_principal || '/img/placeholder.jpg' %>" alt="<%= a.razon_social %>" width="800" height="600" loading="lazy"
                     class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105">
                <% if (a.categoria_nombre) { %>
                  <span class="absolute top-3 left-3 text-xs font-bold text-neutral-900 bg-white/95 dark:bg-slate-900/90 dark:text-slate-100 rounded-full px-2.5 py-1 shadow-sm backdrop-blur">
                    <%= a.categoria_nombre %>
                  </span>
                <% } %>
              </a>
              <div class="flex flex-col grow p-4 sm:p-5">
                <h2 class="font-display text-base sm:text-lg font-semibold text-neutral-900 dark:text-slate-100 leading-snug line-clamp-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors break-words">
                  <a href="/anuncio/<%= a.slug %>" class="hover:underline">
                    <%= a.razon_social %>
                  </a>
                </h2>
                <p class="text-sm leading-relaxed text-neutral-500 dark:text-slate-400 mt-2 line-clamp-2 break-words">
                  <%= a.descripcion_50 %>
                </p>
                <div class="mt-auto pt-4 flex items-center justify-between gap-3 border-t border-neutral-100 dark:border-slate-700 min-w-0">
                  <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm text-neutral-500 dark:text-slate-400 min-w-0">
                    <svg class="w-4 h-4 shrink-0 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.6-7-11a7 7 0 1 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
                    <span class="truncate"><%= [a.ciudad, a.pais].filter(Boolean).join(', ') || 'Colombia' %></span>
                  </span>
                  <a href="/anuncio/<%= a.slug %>" class="shrink-0 inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-primary-600 hover:text-primary-700 dark:text-primary-400 whitespace-nowrap">
                    Ver ficha
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
                  </a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <!-- Paginación responsive -->
        <% if (pagination.totalPages > 1) { %>
          <nav class="mt-10 sm:mt-12 flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 px-2" aria-label="Paginación de resultados">
            <% var build = function(p){ return '/resultados?' + (queryString ? queryString.replace(/&?page=[^&]*/, '') + (queryString.replace(/&?page=[^&]*/, '') ? '&' : '') : '') + 'page=' + p; }; %>
            <a href="<%= build(pagination.page - 1) %>"
               class="h-10 px-3.5 sm:px-4 grid place-items-center rounded-xl text-xs sm:text-sm font-semibold border border-primary-600 text-primary-600 hover:bg-primary-50 dark:border-primary-400 dark:text-primary-400 dark:hover:bg-primary-500/10 transition-colors <%= pagination.hasPrev ? '' : 'pointer-events-none opacity-40' %>"
               <%= !pagination.hasPrev ? 'aria-disabled="true"' : '' %>>
              Anterior
            </a>

            <% for (var p = Math.max(1, pagination.page-2); p <= Math.min(pagination.totalPages, pagination.page+2); p++) { %>
              <a href="<%= build(p) %>"
                 <%= p === pagination.page ? 'aria-current="page"' : '' %>
                 class="w-10 h-10 grid place-items-center rounded-xl text-xs sm:text-sm font-semibold transition-colors <%= p === pagination.page ? 'bg-primary-600 text-white shadow-sm' : 'border border-neutral-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-neutral-700 dark:text-slate-300 hover:border-primary-300 dark:hover:border-primary-500' %>">
                <%= p %>
              </a>
            <% } %>

            <a href="<%= build(pagination.page + 1) %>"
               class="h-10 px-3.5 sm:px-4 grid place-items-center rounded-xl text-xs sm:text-sm font-semibold border border-primary-600 text-primary-600 hover:bg-primary-50 dark:border-primary-400 dark:text-primary-400 dark:hover:bg-primary-500/10 transition-colors <%= pagination.hasNext ? '' : 'pointer-events-none opacity-40' %>"
               <%= !pagination.hasNext ? 'aria-disabled="true"' : '' %>>
              Siguiente
            </a>
          </nav>
        <% } %>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
