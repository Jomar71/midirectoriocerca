# ─────────────────────────────────────────────────────────────
# DirectorioCerca - Variables de entorno
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo .env a un repositorio.
# ─────────────────────────────────────────────────────────────

# ── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Origen publico del sitio (protocolo y dominio, sin rutas)
APP_URL=http://localhost:3000
# Secreto para firmar los JWT de sesión del administrador (cámbialo en producción)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h
# Nombre de la cookie de sesión del panel
COOKIE_NAME=dc_admin_token

# ── Base de datos PostgreSQL ────────────────────────────────
# Opción A: variables separadas
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=directoriocerca
# Opción B (tiene prioridad sobre A si se define): cadena completa
# DATABASE_URL=postgres://usuario:password@localhost:5432/directoriocerca
# SSL para bases de datos en la nube (true/false)
PGSSL=false

# ── Almacenamiento de imágenes ──────────────────────────────
# local | cloudinary | s3   (por ahora solo "local" está implementado)
STORAGE_DRIVER=local
# Carpeta local de subidas: relativa a /public o ruta absoluta
# (ej. /workspace/data/uploads). Si no es escribible, se usa otra automáticamente.
UPLOAD_DIR=uploads
# Tamaño máximo por imagen en MB
UPLOAD_MAX_MB=8

# Cloudinary (solo si STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 (solo si STORAGE_DRIVER=s3)
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Caché Redis (opcional) ──────────────────────────────────
# Actívalo con REDIS_ENABLED=true y una URL válida
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_TTL_SECONDS=60

# ── Correo (Nodemailer / SMTP genérico) ─────────────────────
# transport: smtp | json | ethereal
#  - smtp      : envía correo real (Gmail, Brevo, SendGrid, Mailgun, Zoho, etc.)
#  - ethereal  : crea una cuenta de prueba gratis (correo real de test) al arrancar
#  - json      : no envía, escribe el correo en logs (solo desarrollo)
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="DirectorioCerca <midirectoriocerca@proton.me>"
# Los mensajes y avisos se envían a midirectoriocerca@proton.me

# ── Administrador inicial (semilla) ─────────────────────────
SEED_ADMIN_NAME=Propietario
SEED_ADMIN_EMAIL=midirectoriocerca@proton.me
SEED_ADMIN_PASSWORD=Admin123!

# ── Automatización ──────────────────────────────────────────
# Zona horaria para los cron jobs
CRON_TZ=America/Caracas
# Hora (formato cron 24h) a la que corre la revisión diaria
CRON_DAILY=0 3 * * *
# Días de antelación del aviso de vencimiento
EXPIRY_WARNING_DAYS=30
